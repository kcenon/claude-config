{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "ENABLE_TOOL_SEARCH": "auto:10",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "SSL_CERT_FILE": "/etc/ssl/cert.pem",
    "SSL_CERT_DIR": "/etc/ssl/certs"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git describe:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git merge-base:*)",
      "Bash(git show-ref:*)",
      "Bash(git worktree:*)",
      "Bash(git fetch origin:*)",
      "Bash(git fetch upstream:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue develop:*)",
      "Bash(gh label list:*)",
      "Bash(gh label create:*)",
      "Bash(gh label edit:*)",
      "Bash(gh label delete:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh run download:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh workflow enable:*)",
      "Bash(gh workflow disable:*)",
      "Bash(gh repo view:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release upload:*)",
      "Bash(gh auth status:*)",
      "Bash(gh api -X GET:*)",
      "Bash(gh api -H *)",
      "Bash(gh api repos/*)",
      "Bash(gh api orgs/*)",
      "Bash(gh api users/*)",
      "Bash(gh api user:*)",
      "Bash(gh api rate_limit:*)",
      "Bash(gh api graphql:*)",
      "Bash(act:*)",
      "Bash(cmake:*)",
      "Bash(flock:*)",
      "Bash(jq:*)",
      "Bash(make:*)",
      "Bash(docker build:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker run:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*password*)",
      "Read(**/.envrc)",
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Read(**/id_ed25519)",
      "Read(**/id_ed25519.*)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ecdsa.*)",
      "Read(**/id_dsa)",
      "Read(**/id_dsa.*)",
      "Read(**/.aws/**/credentials)",
      "Read(**/.aws/**/config)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.aws/sso/cache/**)",
      "Read(~/.aws/cli/cache/**)",
      "Read(**/*secrets/**)",
      "Read(**/*credentials/**)",
      "Read(**/*passwords/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "_note": "memory-write-guard is the only file-channel hook since #964: sensitive files are denied by permissions.deny, and read-before-edit is the native Edit/Write contract. The guard acts only on Edit and Write under ~/.claude/memory-shared/memories/ and allows everything else. Timeout is 30s rather than the 5s default: a PreToolUse timeout is fail-OPEN - the harness cancels the hook and the tool call proceeds - so an under-budgeted security guard is silently skipped, never denied. Across 35,276 local hook runs on this matcher the median is 429ms and p99 is 1,020ms, but four contention bursts timed out all three guards of a single call together, peaking at 11,141ms. 30s covers every observed case and matches the Bash channel. See issues #897 and #964.",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-write-guard.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "_note": "dangerous-command-guard has no if: it must read every command through shell grammar and wrappers (#991). merge-gate-guard starts only when the call contains gh pr merge. The wildcards on both sides are deliberate: on Claude Code 2.1.316, Bash(gh pr merge *) did not start it for bash -c, env or command wrappers, which the guard's own scope check catches. A wrong if stops a guard without any error, so tests/hooks/test-bash-channel-minimal.sh pins the rule. See issue #996.",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dangerous-command-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(*gh pr merge*)",
            "command": "~/.claude/hooks/merge-gate-guard.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-integrity-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cleanup.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/prune-permission-rules.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "_note": "The if keeps this hook off reads outside a memory directory. It names any memor* directory under ~/.claude, not ~/.claude/memory-shared alone: on Claude Code 2.1.316, an if on a path rule matched the requested path only, so the narrower rule missed reads through the project memory symlink that docs/MEMORY_SYNC.md offers as a fallback. The hook still checks the memory root itself, so a wider match costs one process and logs nothing extra. See issue #996.",
        "hooks": [
          {
            "type": "command",
            "if": "Read(~/.claude/**/memor*/**)",
            "command": "~/.claude/hooks/memory-access-logger.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-create.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-remove.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/permission-denial-logger.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline-command.sh",
    "refreshInterval": 30
  },
  "outputStyle": "Explanatory",
  "language": "korean",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "docker *",
      "watchman *",
      "gh *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "npmjs.org",
        "*.npmjs.org",
        "registry.npmjs.org",
        "pypi.org",
        "*.pypi.org"
      ],
      "allowLocalBinding": true
    }
  },
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Analyzing",
      "Reviewing",
      "Composing"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "includeGitInstructions": false,
  "skillListingBudgetFraction": 0.02,
  "disableSkillShellExecution": true,
  "description": "Claude Code Global Settings - Applied to all projects (permissions.deny for security)",
  "version": "1.17.1",
  "showTurnDuration": true,
  "teammateMode": "in-process"
}
